# ---------------------------------------------------------------------------
# innoRoutes backend configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# Database (SQLAlchemy URL). SQLite is the default.
DATABASE_URL=sqlite:///./innoroutes.db
# MySQL / MariaDB  (pip install pymysql, see requirements.txt)
# DATABASE_URL=mysql+pymysql://innoroutes:YOUR_DB_PASSWORD@127.0.0.1:3306/innoroutes?charset=utf8mb4
# PostgreSQL       (pip install "psycopg[binary]", see requirements.txt)
# DATABASE_URL=postgresql+psycopg://innoroutes:YOUR_DB_PASSWORD@127.0.0.1:5432/innoroutes

# Signs login tokens and encrypts stored router passwords. Changing it makes
# stored router passwords unreadable (re-enter them in Settings > Routers).
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# Poller
SCHEDULER_ENABLED=true
DEFAULT_POLL_INTERVAL=30
RAW_RETENTION_DAYS=8
HOURLY_RETENTION_DAYS=400

# Seed (python -m app.seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Admin password of the USR-G815 gateways 192.168.9.4 / .5 / .6
SEED_USR_PASSWORD=
# Admin password of the Brovi/Huawei gateways 192.168.9.14 / .15 / .16
SEED_HUAWEI_PASSWORD=
