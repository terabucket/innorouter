{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port 5173 --strictPort"],
      "port": 5173
    },
    {
      "name": "backend-demo",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && DATABASE_URL=sqlite:///./demo.db SCHEDULER_ENABLED=false .venv/bin/uvicorn app.main:app --port 8001"],
      "port": 8001
    },
    {
      "name": "frontend-demo",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && API_URL=http://127.0.0.1:8001 npm run dev -- --port 5174 --strictPort"],
      "port": 5174
    }
  ]
}
